# Môi trường / secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Mặc định bỏ qua .jsonl (file dataset thường rất lớn)
*.jsonl
!sample_*.jsonl

# NHƯNG phải giữ lại các file dưới đây — chúng là ĐẦU VÀO và KẾT QUẢ GỌI LLM
# đã trả tiền để sinh ra, không tái tạo được nếu không có API key.
# Tổng cộng ~1.9MB, hoàn toàn ổn với git. Toàn bộ là dữ liệu hư cấu.
!cv_synthetic.jsonl
!jd_synthetic.jsonl
!data/*.jsonl

# File CV/JD upload thật (chứa PII, không nên commit)
*.pdf
!docs/**/*.pdf

# IDE / OS
.vscode/
.idea/
.DS_Store

# Test / cache
.pytest_cache/
.coverage
htmlcov/

# Model files (nếu train ranker, không commit file model lớn)
*.pkl
*.joblib