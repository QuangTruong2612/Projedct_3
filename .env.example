# ==== LLM ====
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=claude-sonnet-5
LLM_TEMPERATURE=0.0
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://your-api-proxy-domain.com/v1

# ==== Embedding ====
EMBEDDING_PROVIDER=open_source
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
# none | auto (tự thêm "query: " cho model họ e5) | prefix tuỳ ý
# Mặc định none -- xem mục "A note on EMBEDDING_PREFIX" trong README
EMBEDDING_PREFIX=none

# ==== Chấm điểm (các hằng số đã hiệu chỉnh từ dữ liệu, xem README) ====
# Similarity trên mức này thì tính là "khớp rõ" -- CHỈ để hiển thị cho HR,
# không dùng để tính điểm
SKILL_MATCH_THRESHOLD=0.85
# Sàn nhiễu của embedding: dưới mức này coi như không liên quan.
# Hiệu chỉnh từ ~4.000 cặp kỹ năng ghép ngẫu nhiên (trung vị 0.79)
SIMILARITY_FLOOR=0.80
# Phần điểm kinh nghiệm giữ lại khi công việc hoàn toàn trái ngành
EXPERIENCE_RELEVANCE_BASE=0.3

# ==== Hiệu năng ====
# Giới hạn độ dài văn bản đưa vào LLM (CV quá dài sẽ bị cắt bớt)
MAX_INPUT_TOKENS=4000
# Số CV xử lý song song trong /rank -- đặt cao dễ chạm rate limit của provider
RANK_MAX_WORKERS=4

# ==== Bộ lọc rẻ bằng mô hình đã train (train_ranker.py) ====
# Model dùng để chấm nhanh không cần LLM. Để trống thì tắt hẳn.
RANKER_MODEL_PATH=train/extratrees.pkl
# Chỉ gọi LLM chấm chi tiết cho top-K hồ sơ theo điểm mô hình.
# 0 = tắt (LLM chấm tất cả, như trước). Ví dụ 20 = tiết kiệm ~40% lượt gọi LLM
# khi xử lý 100 CV.
RANKER_PREFILTER_TOP_K=0
